      "genericEvidence": "\\b(fully )?remote roles?\\b",
      "genericContext": "\\bhybrid roles?\\b",
      "linkedinBodyOnly": true,
      "atsLocationRemote": "\\b(remote|home[- ]based|work from anywhere|anywhere|worldwide|distributed)\\b",
      "atsLocationNot": "\\b(hybrid|on[- ]?site|office)\\b|\\b(us|u\\.s\\.|usa|united states|canada|north america|americas|latam|apac|asia|australia|india|uk only)\\b"
